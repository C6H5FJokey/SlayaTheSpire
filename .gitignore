# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.pytest-tmp/
*.egg-info/

# 采集与训练数据（导出产物不入库，但导出脚本必须入库）
runs/
dataset/*.jsonl
dataset/manifest.json

# 反编译参考源
ref/

# 本地 Laya 服务（自建 venv + 模型缓存，见 docs/10-deployment.md）
.venv-laya/
.cache/

# 临时草稿
scratch/

# 模组构建产物
mod/build/
*.class

# 本地配置
.env
*.local.toml

# 编辑器
.idea/
.vscode/

# 运行时产物
*.log
human_action.txt

# 微调产物（训练项 / checkpoint / 续跑点 / torch 存盘不入库；脚本必须入库）
finetune/out/
finetune/checkpoints/
*.pt

# pytest 缓存目录（权限异常时会在仓库根留下 pytest-cache-files-*）
pytest-cache-files-*/
